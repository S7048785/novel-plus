# 上游 Java 项目（独立克隆，自带 .git 与 origin 远端，不纳入本仓库）
/novel-plus/

# 安装产物。无前导斜杠 = 任意层级都生效（pnpm 也会在 packages/* 下建 node_modules 链接）
node_modules/

# 工作区工具数据：会话数据、技能包与技能锁文件都是本地工具资产，与仓库无关
/.workbuddy/
/.agents/
skills-lock.json

# OS
.DS_Store
Thumbs.db

# 编辑器：.idea 整目录忽略（子包规则一致）；.vscode 不整体忽略，
# 因为子包规则里特意放行了 settings.json / extensions.json，将来根目录也可能要共享
/.idea/
